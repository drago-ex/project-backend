{
	"name": "drago-ex/project-backend",
	"description": "Preconfigured basic backend module for the basic Drago Project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^4.0",
		"drago-ex/application": "^4.0",
		"drago-ex/project-front": "^1.0"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the backend permission provider."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			}
		},
		"drago-permission": "permission.php"
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
